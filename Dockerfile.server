# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy workspace manifests first for better layer caching
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY server/package.json            ./server/

# Install ALL workspace deps (needed so shared package resolves)
RUN npm ci --workspace=packages/shared --workspace=server --ignore-scripts

# Copy source
COPY packages/shared ./packages/shared
COPY server          ./server

# Build shared types then compile server TypeScript
RUN npm run build --workspace=packages/shared 2>/dev/null || true
RUN npm run build --workspace=server

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY server/package.json            ./server/

# Production deps only
RUN npm ci --workspace=packages/shared --workspace=server \
    --omit=dev --ignore-scripts

# Copy compiled output from builder
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/packages/shared ./packages/shared

# SQLite DB lives in a named volume mounted at /app/data
ENV DB_PATH=/app/data/galactic.db

EXPOSE 4005

CMD ["node", "server/dist/index.js"]
